---
import simpatiaImage from "../../assets/img/simpatia-project.webp";
import maderoImage from "../../assets/img/madero-project.webp";
import hydrogreenImage from "../../assets/img/hydrogreen-project.webp";

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

const images: Record<string, string> = {
  simpatia: simpatiaImage.src,
  "madero-fresh": maderoImage.src,
  hydrogreen: hydrogreenImage.src,
};

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} — Sergio Vazquez  Zamora`}>
  <Navbar />
  <main class="pt-32 pb-24">
    <article class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-ink transition-colors duration-200 mb-12"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Volver a proyectos
      </a>

      <header class="mb-16">
        <div class="flex flex-wrap gap-2 mb-6">
          {
            project.data.tags.map((tag) => (
              <span class="inline-flex items-center gap-1.5 text-xs tracking-wide uppercase text-ink-muted bg-ink/5 px-3 py-1 rounded-full">
                {tag}
              </span>
            ))
          }
        </div>
        <h1
          class="font-display text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight"
          transition:name={`title-${project.id}`}
        >
          {project.data.title}
        </h1>
        <p class="mt-6 text-xl text-ink-muted max-w-3xl leading-relaxed">
          {project.data.description}
        </p>
      </header>

      {
        (images[project.id] || project.data.image) && (
          <div class="aspect-video overflow-hidden rounded-2xl mb-16 bg-ink/5">
            <img
              src={images[project.id] ?? project.data.image!}
              alt={project.data.title}
              class="w-full h-full object-cover"
              transition:name={`image-${project.id}`}
            />
          </div>
        )
      }

      <div class="prose max-w-none">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
    margin-bottom: 1.25rem;
  }

  .prose ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose li {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-ink-muted);
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll('.prose a[href^="http"]').forEach((link) => {
    link.target = "_blank";
    link.rel = "noopener noreferrer";
  });
</script>
