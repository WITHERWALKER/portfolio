---
import { Image } from 'astro:assets';
import '@/styles/prose.css';
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import Tag from '@/components/ui/Tag.astro';
import { render } from 'astro:content';
import { getSortedProjects } from '@/lib/projects';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { image } = project.data;
---

<Layout
  title={`${project.data.title} — ${site.name}`}
  description={project.data.description}
>
  <Navbar />
  <main class="pt-32 pb-24">
    <article class="container-page">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-ink-muted hover:text-ink transition-colors duration-200 mb-12"
      >
        <Icon name="arrowLeft" size={16} />
        Volver a proyectos
      </a>

      <header class="mb-16">
        <div class="flex flex-wrap gap-2 mb-6">
          {project.data.tags.map((tag) => <Tag variant="label">{tag}</Tag>)}
        </div>
        <h1
          class="font-display text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight"
          transition:name={`title-${project.id}`}
        >
          {project.data.title}
        </h1>
        <p class="mt-6 text-xl text-ink-muted max-w-3xl leading-relaxed">
          {project.data.description}
        </p>
      </header>

      {
        image && (
          <div class="aspect-video overflow-hidden rounded-2xl mb-16 bg-ink/5">
            <Image
              src={image}
              alt={project.data.title}
              widths={[768, 1280, 1600]}
              sizes="(min-width: 1280px) 1280px, 100vw"
              class="h-full w-full object-cover"
              transition:name={`image-${project.id}`}
            />
          </div>
        )
      }

      <div class="prose max-w-none">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLAnchorElement>('.prose a[href^="http"]')
      .forEach((link) => {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      });
  });
</script>
