---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
---

<Layout
  title={`Página no encontrada (404) — ${site.name}`}
  description="La página que buscas no existe o fue movida. Vuelve al inicio para explorar mis proyectos y Landing Pages."
>
  <Navbar />
  <main class="pt-32 pb-24">
    <div class="container-page">
      <div
        class="rounded-3xl border border-dashed border-ink/15 bg-white/60 p-10 md:p-14 text-center"
      >
        <div
          class="mx-auto mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-ink text-bg"
        >
          <Icon name="pin" size={22} />
        </div>
        <p class="text-label uppercase text-ink-muted mb-3">Error 404</p>
        <h1 class="font-display text-2xl md:text-3xl font-semibold tracking-tight">
          No se encontró esta página
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-body text-ink-muted">
          La dirección que buscas no existe o fue movida. Mientras tanto, puedes ver mis
          proyectos en el inicio.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button href="/" variant="primary"> Volver al inicio </Button>
          <Button href="/landings" variant="secondary"> Ver Landing Pages </Button>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
