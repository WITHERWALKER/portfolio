---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
---

<section class="min-h-dvh flex items-center pt-16">
  <div class="container-page py-12 sm:py-20 lg:py-24 w-full">
    <p class="text-label uppercase text-ink-muted mb-5 sm:mb-6">{site.eyebrow}</p>
    <h1 class="font-display text-display text-balance max-w-208">{site.tagline}</h1>
    <p class="mt-6 sm:mt-9 text-lede text-ink-muted max-w-2xl text-pretty">
      {site.lede}
    </p>

    <div
      class="mt-7 sm:mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-6"
    >
      <div class="flex items-center gap-3 text-ink-muted">
        <Icon name="pin" size={16} />
        <span class="text-meta text-ink-muted">
          {site.locationShort} · {site.workMode}
        </span>
      </div>
      <div class="w-px h-4 bg-border hidden sm:block"></div>
      <div class="flex items-center gap-3 text-ink-muted">
        <span class="size-2 mx-1 rounded-full bg-green-500"></span>
        <span class="text-meta text-ink-muted">{site.availability}</span>
      </div>
    </div>

    <div
      class="mt-8 sm:mt-12 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4"
    >
      <Button href="/#projects" variant="primary">Ver Proyectos</Button>
      <Button href={site.cv} variant="secondary" download>
        <Icon name="download" size={16} class="mr-2" />
        Descargar CV
      </Button>
    </div>
  </div>
</section>
