---
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
---

<Section
  id="landings-cta"
  title="Landing Pages"
  subtitle="Experimentos de diseño y código que hago por diversión"
>
  <a
    href="/landings"
    aria-label="Ver mis Landing Pages"
    class="group block rounded-3xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
  >
    <article
      class="grid overflow-hidden rounded-3xl border border-border bg-white transition-all duration-500 hover:border-ink/10 hover:shadow-sm md:grid-cols-2"
    >
      {/* Preview: mismo lenguaje visual que ProjectCard */}
      <div class="p-2 sm:p-2.5">
        <div
          class="relative flex aspect-16/11 h-full items-end justify-center overflow-hidden rounded-2xl px-4 pt-6 md:aspect-auto md:min-h-full"
          style="background-color: #f0ece6"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 opacity-[0.04]"
            style="background-image: radial-gradient(circle at 1px 1px, #0f0f0f 1px, transparent 0); background-size: 20px 20px;"
          >
          </div>

          <div
            aria-hidden="true"
            class="relative w-full overflow-hidden rounded-t-xl bg-white shadow-[0_10px_40px_-12px_rgba(0,0,0,0.35),0_4px_12px_rgba(0,0,0,0.08)] ring-1 ring-black/6 sm:rounded-t-[14px]"
          >
            <div
              class="flex h-7 items-center gap-1.5 border-b border-black/6 bg-[#fafaf9] px-3 sm:h-8"
            >
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57] ring-1 ring-black/10"
              ></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e] ring-1 ring-black/10"
              ></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28c840] ring-1 ring-black/10"
              ></span>
              <span
                class="ml-3 hidden h-4 max-w-40 flex-1 rounded-full bg-black/6 sm:block"
              ></span>
            </div>
            <div class="space-y-2.5 p-4 sm:p-5">
              <div class="h-4 w-3/4 rounded-full bg-ink"></div>
              <div class="h-3 w-full rounded-full bg-ink/10"></div>
              <div class="h-3 w-5/6 rounded-full bg-ink/10"></div>
              <div class="flex gap-2 pt-2">
                <div class="h-8 w-24 rounded-lg bg-ink"></div>
                <div class="h-8 w-24 rounded-lg border border-ink/15"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Contenido */}
      <div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
        <h3
          class="mt-3 font-display text-heading text-balance transition-opacity duration-200 group-hover:opacity-70"
        >
          Laboratorio de landing pages
        </h3>
        <p class="mt-3 text-small text-ink-muted text-pretty max-w-md">
          Un espacio donde diseño y desarrollo landing pages solo por el placer de crear,
          experimentar y perfeccionar cada detalle.
        </p>

        <div class="mt-7">
          <span
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-ink px-6 py-3 text-small font-medium text-bg transition-all duration-200 group-hover:gap-3 group-hover:bg-ink/90"
          >
            Ver el laboratorio
            <Icon name="arrowRight" size={16} />
          </span>
        </div>
      </div>
    </article>
  </a>
</Section>
