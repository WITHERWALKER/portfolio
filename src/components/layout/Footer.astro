---
import { contactLinks, navLinks, site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container-page py-16">
    <div class="flex flex-col md:flex-row items-start justify-between gap-12">
      <div class="max-w-sm">
        <p class="font-display text-2xl font-semibold tracking-tight">{site.name}</p>
        <p class="mt-3 text-sm text-ink-muted leading-relaxed">{site.summary}</p>
      </div>

      <div class="flex gap-16">
        <nav>
          <p class="text-xs tracking-wide uppercase text-ink-muted mb-4">Navegación</p>
          <ul class="space-y-2">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink hover:text-ink-muted transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav>
          <p class="text-xs tracking-wide uppercase text-ink-muted mb-4">Contacto</p>
          <ul class="space-y-2">
            {
              contactLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="text-sm text-ink hover:text-ink-muted transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div
      class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-xs text-ink-muted">
        &copy; {year}
        {site.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
