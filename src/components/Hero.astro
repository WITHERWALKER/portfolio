---
import Button from "./Button.astro";
---

<section class="min-h-dvh flex items-center pt-16">
  <div
    class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12 py-12 sm:py-20 lg:py-24 w-full"
  >
    <p class="text-label uppercase text-ink-muted mb-5 sm:mb-6">
      Desarrollo Web · Soporte Técnico
    </p>
    <h1 class="font-display text-display text-balance max-w-208">
      Diseño interfaces. Desarrollo soluciones.
    </h1>
    <p class="mt-6 sm:mt-9 text-lede text-ink-muted max-w-2xl text-pretty">
      Transformo ideas en productos digitales claros y funcionales. Combino
      desarrollo web, atención al detalle y soporte técnico para crear
      soluciones que realmente funcionen.
    </p>
    <div
      class="mt-7 sm:mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-6"
    >
      <div class="flex items-center gap-3 text-ink-muted">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span class="text-meta text-ink-muted">Torreón, México · Remoto</span>
      </div>
      <div class="w-px h-4 bg-border hidden sm:block"></div>
      <div class="flex items-center gap-3 text-ink-muted">
        <span class="size-2 mx-1 rounded-full bg-green-500"></span>
        <span class="text-meta text-ink-muted">Actualmente disponible</span>
      </div>
    </div>
    <div
      class="mt-8 sm:mt-12 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4"
    >
      <Button href="/#projects" variant="primary">Ver Proyectos</Button>
      <Button href="/cv-sergiovz.pdf" variant="secondary" download>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mr-2"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        Descargar CV
      </Button>
    </div>
  </div>
</section>
