---
import Button from './Button.astro';
---

<section class="min-h-screen flex items-center pt-16">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12 py-24 w-full">
    <p class="text-sm tracking-wide uppercase text-ink-muted mb-6">Desarrollo Web</p>
    <h1 class="font-display text-6xl font-semibold tracking-tight max-w-2xl">
      Diseño interfaces. Desarrollo experiencias.
    </h1>
    <p class="mt-8 text-lg md:text-xl text-ink-muted max-w-2xl leading-relaxed">
     Ayudo a transformar ideas en productos digitales modernos, combinando diseño, rendimiento y un enfoque meticuloso en cada detalle.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-6">
      <div class="flex items-center gap-3 text-ink-muted">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span class="text-sm">Mexico, Remoto</span>
      </div>
      <div class="w-px h-4 bg-border hidden sm:block"></div>
      <div class="flex items-center gap-3 text-ink-muted">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        <span class="text-sm">Actualmente disponible</span>
      </div>
    </div>
    <div class="mt-10 flex items-center gap-4">
      <Button href="/#projects" variant="primary">Ver Proyectos</Button>
      <Button href="/cv-sergiovz.pdf" variant="secondary" download>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" x2="12" y1="15" y2="3"/>
        </svg>
        Descargar CV
      </Button>
    </div>
  </div>
</section>
