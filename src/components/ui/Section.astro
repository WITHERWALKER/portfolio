---
import SectionTitle from './SectionTitle.astro';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  bordered?: boolean;
}

const { id, title, subtitle, bordered = true } = Astro.props;
---

<section
  id={id}
  class:list={['py-24 md:py-32 scroll-mt-20', bordered && 'border-t border-border']}
>
  <div class="container-page">
    <SectionTitle title={title} subtitle={subtitle} />
    <slot />
  </div>
</section>
