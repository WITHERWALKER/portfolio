---
const year = new Date().getFullYear();

const links = [
  { href: "/#projects", label: "Proyectos" },
  { href: "/#about", label: "Sobre mi" },
  { href: "/#experience", label: "Experiencia" },
  { href: "/#skills", label: "Habilidades" },
  { href: "/#contact", label: "Contacto" },
];
---

<footer class="border-t border-border">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12 py-16">
    <div class="flex flex-col md:flex-row items-start justify-between gap-12">
      <div class="max-w-sm">
        <p class="font-display text-2xl font-semibold tracking-tight">
          Sergio Vazquez Zamora
        </p>
        <p class="mt-3 text-sm text-ink-muted leading-relaxed">
          Ingeniero Informático con experiencia en desarrollo web y soporte
          técnico. Me gusta crear soluciones digitales claras, funcionales y
          bien pensadas.
        </p>
      </div>
      <div class="flex gap-16">
        <nav>
          <p class="text-xs tracking-wide uppercase text-ink-muted mb-4">
            Navegación
          </p>
          <ul class="space-y-2">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink hover:text-ink-muted transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav>
          <p class="text-xs tracking-wide uppercase text-ink-muted mb-4">
            Contacto
          </p>
          <ul class="space-y-2">
            <li>
              <a
                href="mailto:sergiovazquezzamora7@gmail.com"
                class="text-sm text-ink hover:text-ink-muted transition-colors duration-200"
              >
                Email
              </a>
            </li>

            <li>
              <a
                href="https://github.com/WITHERWALKER"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-ink hover:text-ink-muted transition-colors duration-200"
              >
                GitHub
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
    <div
      class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-xs text-ink-muted">
        &copy; {year} Sergio Vazquez Zamora. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
