---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-12 lg:mb-16">
  <h2 class="font-display text-title text-balance">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-5 lg:mt-6 text-lede text-ink-muted max-w-2xl text-pretty">
        {subtitle}
      </p>
    )
  }
</div>
