---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-12">
  <h2 class="font-display text-5xl font-semibold tracking-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-lg text-ink-muted max-w-2xl">
      {subtitle}
    </p>
  )}
</div>
