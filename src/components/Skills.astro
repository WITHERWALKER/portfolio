---
import SectionTitle from './SectionTitle.astro';

const skills = [
  { category: 'Lenguajes', items: ['JavaScript', 'TypeScript', 'SQL', 'C#'] },
  { category: 'Frontend', items: ['React', 'Astro', 'Vite', 'Tailwind CSS', 'HTML', 'CSS', 'Axios', 'Zod'] },
  { category: 'Backend', items: ['Node.js', 'Express', 'ASP.NET', 'Entity Framework', 'REST APIs', 'Cloudflare Workers'] },
  { category: 'Bases de datos', items: ['PostgreSQL', 'MySQL', 'MongoDB', 'SQL Server', 'Supabase', 'Firebase'] },
  { category: 'Herramientas', items: ['Git', 'GitHub', 'Postman', 'Resend', 'Power BI'] },
];
---

<section id="skills" class="py-24 md:py-32 border-t border-border">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12">
    <SectionTitle title="Habilidades" subtitle="Tecnologías con las que trabajo" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-12">
      {skills.map((group) => (
        <div>
          <h3 class="text-sm tracking-wide uppercase text-ink-muted mb-4">{group.category}</h3>
          <ul class="space-y-2">
            {group.items.map((item) => (
              <li class="text-ink">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
