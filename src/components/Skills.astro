---
import SectionTitle from "./SectionTitle.astro";

const skills = [
  { category: "Lenguajes", items: ["JavaScript", "TypeScript", "SQL", "C#"] },
  {
    category: "Frontend",
    items: ["React", "Astro", "Vite", "Tailwind CSS", "HTML", "CSS"],
  },
  {
    category: "Backend",
    items: ["Node.js", "Express", "ASP.NET", "REST APIs", "Cloudflare Workers"],
  },
  {
    category: "Bases de datos",
    items: ["PostgreSQL", "SQL Server", "Supabase", "Firebase", "MySQL"],
  },
  { category: "Herramientas", items: ["Git", "GitHub", "Postman", "Power BI"] },
  {
    category: "Apps Mobile",
    items: ["React Native", "Expo"],
  },
  {
    category: "Soporte Técnico",
    items: [
      "Diagnóstico de hardware/software",
      "Mantenimiento preventivo y correctivo",
      "Instalación de sistemas",
    ],
  },
];
---

<section
  id="skills"
  class="py-16 md:py-24 xl:py-32 border-t border-border scroll-mt-20"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12">
    <SectionTitle
      title="Habilidades"
      subtitle="Tecnologías y áreas con las que trabajo"
    />
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12"
    >
      {
        skills.map((group) => (
          <div>
            <h3 class="text-label uppercase text-ink-muted mb-5">
              {group.category}
            </h3>
            <ul class="space-y-2">
              {group.items.map((item) => (
                <li class="text-body text-ink">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
