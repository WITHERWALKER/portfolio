---
import SectionTitle from "./SectionTitle.astro";

const experiences = [
  {
    role: "Desarrollador Web",
    company: "Madero Fresh",
    period: "2026",
    description:
      "Desarrollé una plataforma web completa para una empresa de comercialización de productos del campo. Implementé un panel administrativo para gestionar el catálogo, el flujo de solicitudes de cotización con almacenamiento seguro y el envío automático de correos. Estructuré la aplicación con una arquitectura escalable pensando en su mantenimiento y crecimiento futuro.",
    type: "Freelance",
  },
  {
    role: "Desarrollador Frontend",
    company: "Reda / SimpatIA",
    period: "2025",
    description:
      "Participé en el desarrollo de una plataforma web para la gestión de reportes ciudadanos. Implementé módulos de tickets, direcciones y calendario, integrando la interfaz con servicios backend. Colaboré en equipo usando control de versiones y participé en pruebas funcionales para asegurar la calidad del sistema.",
    type: "Residencias Profesionales",
  },
  {
    role: "Desarrollador Frontend",
    company: "HydroGreen",
    period: "2024",
    description:
      "Diseñé y desarrollé un dashboard web para el monitoreo de un sistema de hidroponía. Implementé la visualización de datos provenientes de sensores y la consulta de información actualizada del cultivo, enfocándome en una interfaz clara y responsive.",
    type: "Proyecto académico",
  },
  {
    role: "Soporte Técnico",
    company: "Instituto Tecnológico de Torreón (CECOM)",
    period: "2024",
    description:
      "Brindé soporte técnico a usuarios y equipos de cómputo. Realicé mantenimiento preventivo y correctivo, instalación y actualización de sistemas operativos y software, y diagnóstico de fallas de hardware y software. Colaboré en la administración del laboratorio de cómputo.",
    type: "Servicio Social",
  },
];
---

<section
  id="experience"
  class="py-16 md:py-24 xl:py-32 border-t border-border scroll-mt-20"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12">
    <SectionTitle title="Experiencia" subtitle="Mi trayectoria profesional" />
    <div class="flex flex-col divide-y divide-border">
      {
        experiences.map((exp) => (
          <div class="py-8 first:pt-0 last:pb-0">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
              <h3 class="font-display text-heading">{exp.role}</h3>
              <p class="text-meta text-ink-muted whitespace-nowrap tabular-nums">
                {exp.period}
              </p>
            </div>
            <p class="mt-1 text-body text-ink-muted">{exp.company}</p>
            <p class="mt-2 text-label uppercase text-ink-muted/70">
              {exp.type}
            </p>
            <p class="mt-4 text-body text-ink-muted text-pretty max-w-3xl">
              {exp.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
