---
import SectionTitle from "./SectionTitle.astro";
import Button from "./Button.astro";
---

<section
  id="contact"
  class="py-16 md:py-24 xl:py-32 border-t border-border scroll-mt-20"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 xl:px-12">
    <SectionTitle title="Contacto" subtitle="Hablemos de tu próximo proyecto" />
    <div class="max-w-xl">
      <p class="text-lede text-ink-muted text-pretty">
        Estoy abierto a oportunidades de desarrollo web, soporte técnico y
        proyectos donde pueda seguir creciendo. Si tienes una idea o una
        vacante, no dudes en escribirme.
      </p>
      <div class="mt-8 flex flex-col gap-2 max-w-fit">
        <div class="flex justify-between items-center gap-6">
          <a
            href="mailto:sergiovazquezzamora7@gmail.com"
            class="flex items-center gap-3 text-ink hover:opacity-70 transition-opacity duration-200 text-lede font-medium"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            Email
          </a>

          <button
            id="copy-email"
            class="p-2 text-ink-muted hover:text-ink transition-colors duration-200"
            aria-label="Copiar email"
          >
            <svg
              id="icon-copy"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              ></path>
            </svg>
            <svg
              id="icon-check"
              class="hidden"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        </div>
        <div class="flex justify-between items-center gap-6">
          <a
            href="https://github.com/WITHERWALKER"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-ink hover:opacity-70 transition-opacity duration-200 text-lede font-medium"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              ></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            Github
          </a>
          <button
            id="copy-github"
            class="p-2 text-ink-muted hover:text-ink transition-colors duration-200"
            aria-label="Copiar GitHub"
          >
            <svg
              id="icon-copy-gh"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              ></path>
            </svg>
            <svg
              id="icon-check-gh"
              class="hidden"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
        </div>
      </div>
      <div class="mt-10">
        <Button href="/cv-sergiovz.pdf" variant="secondary" download>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mr-2"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" x2="12" y1="15" y2="3"></line>
          </svg>
          Descargar CV
        </Button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function setupCopy(btnId, text, iconCopyId, iconCheckId) {
    const btn = document.getElementById(btnId);
    btn?.addEventListener("click", () => {
      navigator.clipboard.writeText(text).then(() => {
        const iconCopy = document.getElementById(iconCopyId);
        const iconCheck = document.getElementById(iconCheckId);
        iconCopy.classList.add("hidden");
        iconCheck.classList.remove("hidden");
        setTimeout(() => {
          iconCopy.classList.remove("hidden");
          iconCheck.classList.add("hidden");
        }, 2000);
      });
    });
  }

  setupCopy(
    "copy-email",
    "sergiovazquezzamora7@gmail.com",
    "icon-copy",
    "icon-check",
  );
  setupCopy(
    "copy-github",
    "https://github.com/WITHERWALKER",
    "icon-copy-gh",
    "icon-check-gh",
  );
</script>
